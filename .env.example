# ─── Telegram ──────────────────────────────────────────────────────────────────
# Obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ton Chat ID — obtenu via @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Twelve Data (prix marché) ─────────────────────────────────────────────────
# Gratuit sur https://twelvedata.com — 800 req/jour
# Nécessaire pour: bougies, FVG, bris de structure, DXY
# Laisser vide pour désactiver les analyses marché
TWELVEDATA_API_KEY=your_twelvedata_key_here

# ─── Nextcloud (historique & rapports) ────────────────────────────────────────
# URL de ton instance Nextcloud (sans slash final)
NEXTCLOUD_URL=https://cloud.ton-serveur.fr
# Nom d'utilisateur Nextcloud
NEXTCLOUD_USERNAME=ton_user
# Mot de passe ou token d'application (Paramètres > Sécurité > Token d'application)
NEXTCLOUD_PASSWORD=ton_password_ou_token
# Dossier distant où stocker les fichiers (sera créé automatiquement)
NEXTCLOUD_FOLDER=GoldyXrogers

# ─── Interne ───────────────────────────────────────────────────────────────────
TZ=UTC
